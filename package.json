{
  "name": "codex-midi",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Transport-neutral Codex Micro compatibility bridge for MIDI controllers",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "bin": {
    "codex-midi": "./src/cli.ts"
  },
  "scripts": {
    "bridge": "bun src/cli.ts bridge",
    "launch": "bun src/cli.ts launch",
    "midi:list": "bun src/cli.ts midi list",
    "midi:monitor": "bun src/cli.ts midi monitor",
    "check": "bunx tsc -p tsconfig.json --noEmit",
    "test": "bun test test",
    "verify": "bun run check && bun run test"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "@julusian/midi": "3.6.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  },
  "trustedDependencies": [
    "@julusian/midi"
  ]
}
